TRAC_MCP_SOCKET=/run/trac-mcp/trac.sock
# Optional group name or numeric GID for the broker socket. Leave empty to keep
# the broker process's current group ownership.
TRAC_MCP_SOCKET_GROUP=
TRAC_MCP_ENVIRONMENTS=example=/srv/trac/example
TRAC_MCP_AUTHOR=MCP
# Comma-separated numeric OS UIDs allowed to invoke broker-side local admin operations.
# Leave empty/unset to disable those operations. Do not include the MCP adapter UID unless
# you intentionally want that OS account to have the local-admin tier.
TRAC_MCP_ADMIN_UIDS=
